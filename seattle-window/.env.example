# Copy to .env. Never commit or share .env.
# Request a Puget Sound OneBusAway key from oba_api_key@soundtransit.org.
OBA_API_KEY=
# Without an OBA key, experimental GPS estimates use a local Metro GTFS index.
# Refresh it after service changes with npm run update:gtfs.
# Optional custom paths; learning stays in ignored var/ by default:
# GTFS_INDEX=data/metro-gtfs.json
# ESTIMATOR_STATE_PATH=var/eta-learning.json
HOME_STOP_ID=1_29530
# Optional: a verified Fremont-bound boarding stop for routes 31/32.
# Leave blank until you have checked the stop and direction in OneBusAway.
FREMONT_STOP_ID=
PORT=8787
# Keep local for Mac development. On your trusted home LAN, set HOST=0.0.0.0
# when the E1003 needs to reach the Pi. Do not expose this service to the internet.
HOST=127.0.0.1
# Optional Raspberry Pi system Chromium executable, used only for PNG export:
# CHROMIUM_EXECUTABLE=/usr/bin/chromium
